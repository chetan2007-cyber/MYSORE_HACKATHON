# ==============================================================================
# CIVICTRACK BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and adjust values for your environment.
# Never commit real credentials or production secrets to Git.
# ==============================================================================

# Runtime Environment (development | production)
NODE_ENV=development

# Server Listening Port
PORT=5000

# MongoDB Connection URI
# Local: mongodb://127.0.0.1:27017/civictrack
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/civictrack

# JWT Signing Secret & Expiration
# Use a strong, cryptographically secure 256-bit random string for production.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Allowed Frontend Client Origin(s) for CORS
# Single URL or comma-separated list of URLs without trailing slashes.
CLIENT_URL=http://localhost:5173

# SMTP Mail Server Configuration (for real OTP and staff setup emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CivicTrack Operations <no-reply@civictrack.gov>"

# OTP Simulation Mode
# Set to 'true' in development to output OTPs to terminal logs.
# MUST BE 'false' in production.
OTP_DEV_MODE=true

# Authentication Cookie Security Flags
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
